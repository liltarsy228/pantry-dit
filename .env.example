# Скопируйте этот файл в .env и замените значения, отмеченные CHANGE_ME.
# .env не попадает в Git и предназначен только для локальных секретов.

DJANGO_SECRET_KEY=CHANGE_ME_GENERATE_A_LONG_RANDOM_SECRET
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=it_assets
POSTGRES_USER=it_assets
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
